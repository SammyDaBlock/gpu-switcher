<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- window fallback when Mica isn't available (and for screenshots) -->
    <SolidColorBrush x:Key="Bg" Color="#202020"/>
    <!-- layers on top of Mica -->
    <SolidColorBrush x:Key="LayerFill" Color="#4C3A3A3A"/>
    <SolidColorBrush x:Key="Panel" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="DialogFooter" Color="#202020"/>
    <SolidColorBrush x:Key="CardFill" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="CardHover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Control" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="ControlHover" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="Subtle" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="SubtleHover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SubtleSelected" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="LineStrong" Color="#28FFFFFF"/>
    <SolidColorBrush x:Key="Thumb" Color="#5CFFFFFF"/>

    <!-- text -->
    <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Sub" Color="#A6A6A6"/>
    <SolidColorBrush x:Key="Faint" Color="#787878"/>

    <!-- primary = neutral, so color always means a GPU -->
    <SolidColorBrush x:Key="Primary" Color="#ECECEC"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnFill" Color="#141414"/>

    <!-- states (Windows 11 system colors) -->
    <SolidColorBrush x:Key="Ok" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="Warn" Color="#FCE100"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#29FCE100"/>
    <SolidColorBrush x:Key="Danger" Color="#FF99A4"/>

    <!-- GPUs by role: 0 = the one the monitors are on, then the others -->
    <SolidColorBrush x:Key="Gpu0" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="Gpu0Soft" Color="#264CC2FF"/>
    <SolidColorBrush x:Key="Gpu1" Color="#FF8A4C"/>
    <SolidColorBrush x:Key="Gpu1Soft" Color="#26FF8A4C"/>
    <SolidColorBrush x:Key="Gpu2" Color="#B794F6"/>
    <SolidColorBrush x:Key="Gpu2Soft" Color="#26B794F6"/>
    <SolidColorBrush x:Key="Gpu3" Color="#F472B6"/>
    <SolidColorBrush x:Key="Gpu3Soft" Color="#26F472B6"/>
</ResourceDictionary>
