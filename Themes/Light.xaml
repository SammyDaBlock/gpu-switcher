<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- window fallback when Mica isn't available (and for screenshots) -->
    <SolidColorBrush x:Key="Bg" Color="#F3F3F3"/>
    <!-- layers on top of Mica -->
    <SolidColorBrush x:Key="LayerFill" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DialogFooter" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="CardFill" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="CardHover" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="Control" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="ControlHover" Color="#80F9F9F9"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#4DF9F9F9"/>
    <SolidColorBrush x:Key="Subtle" Color="#00000000"/>
    <SolidColorBrush x:Key="SubtleHover" Color="#09000000"/>
    <SolidColorBrush x:Key="SubtleSelected" Color="#10000000"/>
    <SolidColorBrush x:Key="Line" Color="#14000000"/>
    <SolidColorBrush x:Key="LineStrong" Color="#29000000"/>
    <SolidColorBrush x:Key="Thumb" Color="#72000000"/>

    <!-- text -->
    <SolidColorBrush x:Key="Text" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="Sub" Color="#5F5F5F"/>
    <SolidColorBrush x:Key="Faint" Color="#8A8A8A"/>

    <!-- primary = neutral, so color always means a GPU -->
    <SolidColorBrush x:Key="Primary" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="OnFill" Color="#FFFFFF"/>

    <!-- states (Windows 11 system colors) -->
    <SolidColorBrush x:Key="Ok" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="Warn" Color="#9D5D00"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#FFF4CE"/>
    <SolidColorBrush x:Key="Danger" Color="#C42B1C"/>

    <!-- GPUs by role: 0 = the one the monitors are on, then the others -->
    <SolidColorBrush x:Key="Gpu0" Color="#005FB8"/>
    <SolidColorBrush x:Key="Gpu0Soft" Color="#1F005FB8"/>
    <SolidColorBrush x:Key="Gpu1" Color="#C24E00"/>
    <SolidColorBrush x:Key="Gpu1Soft" Color="#1FC24E00"/>
    <SolidColorBrush x:Key="Gpu2" Color="#6B3FC4"/>
    <SolidColorBrush x:Key="Gpu2Soft" Color="#1F6B3FC4"/>
    <SolidColorBrush x:Key="Gpu3" Color="#B4127A"/>
    <SolidColorBrush x:Key="Gpu3Soft" Color="#1FB4127A"/>
</ResourceDictionary>
