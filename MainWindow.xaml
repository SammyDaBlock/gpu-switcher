<Window x:Class="GpuSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GpuSwitcher.UI"
        Title="GPU Switcher" Width="1200" Height="780" MinWidth="1080" MinHeight="560"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <!-- segmented GPU picker used everywhere -->
        <DataTemplate x:Key="ChoicePicker">
            <Border Background="{DynamicResource Control}" CornerRadius="6" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="1" HorizontalAlignment="Left">
                <ItemsControl ItemsSource="{Binding Choices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SegButton}" Content="{Binding Label}" Click="Choice_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DataTemplate>

        <!-- GPU card in the header -->
        <Style x:Key="GpuCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,11"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{Binding Soft}"/>
                    <Setter Property="BorderBrush" Value="{Binding Brush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24,14,24,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="GPU Switcher" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Pick which GPU every app runs on" Style="{StaticResource SubText}" FontSize="13" Margin="1,2,0,0"/>
            </StackPanel>
            <ItemsControl x:Name="GpuCards" HorizontalAlignment="Right">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GpuCard}" Width="{Binding Width}" Margin="10,0,0,0" Cursor="Hand" Tag="{Binding Key}"
                                MouseLeftButtonUp="GpuCard_Click" ToolTip="Click to show only apps on this GPU">
                            <StackPanel>
                                <DockPanel>
                                    <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Visibility="{Binding BadgeVisible}" ToolTip="Your monitors are plugged into this GPU">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{DynamicResource Sub}" Margin="0,0,4,0"/>
                                            <TextBlock Text="Monitors" FontSize="11" Foreground="{DynamicResource Sub}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <ProgressBar Style="{StaticResource Meter}" ui:Anim.SmoothValue="{Binding Util, Mode=OneWay}" Maximum="100" Foreground="{Binding Brush}" Margin="0,10,0,8"/>
                                <DockPanel>
                                    <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" DockPanel.Dock="Right" FontSize="12"/>
                                    <TextBlock Style="{StaticResource SubText}">
                                        <Run Text="{Binding UtilText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding MemText, Mode=OneWay}"/>
                                    </TextBlock>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <!-- banner while a GPU is off -->
            <Border x:Name="BusyBanner" Visibility="Collapsed" Style="{StaticResource InfoBar}" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Warn}" Margin="0,0,12,0"/>
                    <Button DockPanel.Dock="Right" Content="Re-enable now" Click="EnableAll_Click"/>
                    <TextBlock x:Name="BusyText" VerticalAlignment="Center" Text="A GPU is temporarily off. It comes back automatically."/>
                </DockPanel>
            </Border>
            <!-- this app needs two GPUs -->
            <Border x:Name="OneGpuBanner" Visibility="Collapsed" Style="{StaticResource InfoBar}" Background="{DynamicResource CardFill}" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Sub}" Margin="0,0,12,0"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Only one GPU found. GPU Switcher is made for PCs with two or more GPUs (for example a gaming card plus a second card or the CPU's built-in graphics), so there's nothing to switch between here."/>
                </DockPanel>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="2" x:Name="Tabs">
            <!-- ================= RUNNING ================= -->
            <TabItem Header="Running">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid DockPanel.Dock="Left" Width="220">
                            <TextBox x:Name="Search" TextChanged="Search_TextChanged" Padding="10,6,32,6"/>
                            <TextBlock x:Name="SearchHint" Text="Search apps" Foreground="{DynamicResource Sub}" FontSize="13" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Sub}" HorizontalAlignment="Right" Margin="0,0,11,0" IsHitTestVisible="False"/>
                        </Grid>
                        <ContentPresenter x:Name="GpuFilterPicker" DockPanel.Dock="Left" ContentTemplate="{StaticResource ChoicePicker}" Margin="12,0,0,0" VerticalAlignment="Center"
                                          ToolTip="Only show apps running on this GPU"/>
                        <CheckBox x:Name="ShowSystem" DockPanel.Dock="Left" Style="{StaticResource Switch}" Content="Windows processes" Margin="18,0,0,0" VerticalAlignment="Center" Click="ShowSystem_Click"/>
                        <Button x:Name="FixAllButton" DockPanel.Dock="Right" Content="Put everything on its GPU" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="FixAll_Click"
                                ToolTip="Moves every running app to the GPU it's set to. Chromium apps switch live, other apps restart (you get asked first), games are never restarted automatically."/>
                        <ItemsControl x:Name="EvacButtons" HorizontalAlignment="Right">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Key}" Click="Evacuate_Click" Margin="8,0,0,0"
                                            ToolTip="Turns this GPU off for about 5 seconds. Apps that can handle it move to the other GPU, the rest may crash or restart. Your monitors aren't affected.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource Warn}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Label}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <Border Style="{StaticResource Layer}">
                        <DockPanel Grid.IsSharedSizeScope="True">
                            <!-- column headers -->
                            <Grid DockPanel.Dock="Top" Margin="10,0,18,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/><ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="76"/><ColumnDefinition Width="Auto" MinWidth="206" SharedSizeGroup="Pick"/><ColumnDefinition Width="150"/><ColumnDefinition Width="132"/><ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="App" Style="{StaticResource Caption}"/>
                                <TextBlock Grid.Column="2" Text="Running on" Style="{StaticResource Caption}"/>
                                <TextBlock Grid.Column="3" Text="Usage" Style="{StaticResource Caption}"/>
                                <TextBlock Grid.Column="4" Text="VRAM" Style="{StaticResource Caption}"/>
                                <TextBlock Grid.Column="5" Text="Use GPU" Style="{StaticResource Caption}"/>
                                <TextBlock Grid.Column="6" Text="Switching" Style="{StaticResource Caption}"/>
                                <TextBlock Grid.Column="8" Text="Force" Style="{StaticResource Caption}"/>
                            </Grid>

                            <ListBox x:Name="RunningList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/><ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="76"/><ColumnDefinition Width="Auto" MinWidth="206" SharedSizeGroup="Pick"/><ColumnDefinition Width="150"/><ColumnDefinition Width="132"/><ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip="{Binding ExePath}" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ExeName}" Style="{StaticResource SubText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <!-- GPU pill -->
                                            <Border Grid.Column="2" Background="{Binding OnSoft}" CornerRadius="10" Padding="8,2,10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding OnBrush}" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding OnText}" Foreground="{Binding OnBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding UtilText}" VerticalAlignment="Center" FontSize="13"/>
                                            <TextBlock Grid.Column="4" Text="{Binding MemText}" VerticalAlignment="Center" Style="{StaticResource SubText}"/>
                                            <ContentPresenter Grid.Column="5" Content="{Binding}" ContentTemplate="{StaticResource ChoicePicker}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding KindText}" Foreground="{Binding KindBrush}" ToolTip="{Binding KindNote}" VerticalAlignment="Center" FontSize="12"/>
                                            <Grid Grid.Column="7" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Button Content="{Binding ActionText}" Visibility="{Binding ActionVisible}" ToolTip="{Binding ActionTip}" Style="{StaticResource GpuButton}"
                                                        Background="{Binding PrefSoft}" BorderBrush="{Binding PrefBrush}" Foreground="{Binding PrefBrush}" Click="Action_Click"/>
                                                <TextBlock Text="Working…" Visibility="{Binding BusyVisible}" Style="{StaticResource SubText}"/>
                                            </Grid>
                                            <CheckBox Grid.Column="8" Style="{StaticResource Switch}" IsChecked="{Binding Force, Mode=OneWay}" IsEnabled="{Binding ForceAllowed}"
                                                      ToolTip="{Binding ForceTip}" ToolTipService.ShowOnDisabled="True" Click="Force_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ================= SAVED ================= -->
            <TabItem Header="Saved choices">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button x:Name="RemoveMissing" DockPanel.Dock="Right" Content="Remove missing" Click="RemoveMissing_Click" VerticalAlignment="Top"
                                ToolTip="Removes choices for apps that don't exist anymore (old Discord versions, uninstalled games...)"/>
                        <TextBlock Style="{StaticResource SubText}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,0,24,0" MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="Every app with a GPU choice saved in Windows. These apply on the next launch, even when GPU Switcher isn't running. Auto = remove the choice. Apps that update into a new folder (Discord, Roblox Studio) keep their choice automatically."/>
                    </DockPanel>
                    <Border Style="{StaticResource Layer}">
                        <DockPanel Grid.IsSharedSizeScope="True">
                            <Grid DockPanel.Dock="Top" Margin="10,0,18,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto" MinWidth="206" SharedSizeGroup="Pick"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="App" Style="{StaticResource Caption}"/>
                                <TextBlock Grid.Column="3" Text="Use GPU" Style="{StaticResource Caption}"/>
                            </Grid>
                            <ListBox x:Name="SavedList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto" MinWidth="206" SharedSizeGroup="Pick"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SubText}" Style="{StaticResource SubText}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Chip}" Visibility="{Binding BadgeVisible}" ToolTip="Set by auto-assign">
                                                <TextBlock Text="auto" FontSize="11" Foreground="{DynamicResource Sub}"/>
                                            </Border>
                                            <ContentPresenter Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource ChoicePicker}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ================= FORCE ================= -->
            <TabItem Header="Force mode">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Add Fortnite" Click="AddFortnite_Click" Margin="0,0,8,0"
                                    ToolTip="Fortnite with its launcher and anti-cheat exes already filled in"/>
                            <Button Style="{StaticResource AccentButton}" Click="AddGame_Click"
                                    ToolTip="Pick any game's exe. Unreal Engine games: pick the ...-Win64-Shipping.exe in the game's Binaries\Win64 folder.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Add a game"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SubText}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,0,24,0" MaxWidth="820" HorizontalAlignment="Left"
                                   Text="For games that ignore every GPU setting. When the game (or its launcher) starts, the other GPU is turned off until the game has picked its GPU, then turned back on. Nothing touches the game itself. Turn it on for any game with the Force switch in the Running tab."/>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Layer}" Padding="6">
                        <Grid>
                            <ListBox x:Name="ForceList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource SmallButton}" Click="RemoveRule_Click" VerticalAlignment="Center"/>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="No games in force mode yet. Add one here, or use the Force switch in the Running tab while the game runs." FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=ForceList}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12,12,6,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Activity" Style="{StaticResource H2}" Margin="4,0,0,6"/>
                            <ListBox x:Name="ActivityList" FontFamily="Cascadia Mono, Consolas" FontSize="12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource Sub}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"/></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= STARTUP ================= -->
            <TabItem Header="Startup apps">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubText}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,12" MaxWidth="900" HorizontalAlignment="Left"
                               Text="GPU Switcher can start your startup apps itself, after it's ready: their GPU choice is fixed first (also right after an app updated, like Discord), then they launch one by one. Taken-over apps show as Disabled in Task Manager, that's normal. 'Windows' = Windows starts it like before."/>
                    <Border DockPanel.Dock="Top" x:Name="StartupWarning" Visibility="Collapsed" Style="{StaticResource InfoBar}" Margin="0,0,0,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Warn}" Margin="0,0,12,0"/>
                            <Button DockPanel.Dock="Right" Content="Turn it on" Click="StartupAutostartOn_Click"/>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="GPU Switcher isn't set to start with Windows, so the apps it took over won't start at all."/>
                        </DockPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Click="StartupAdd_Click" Margin="0,0,8,0"
                                ToolTip="Pick a running or installed app (or browse for one). GPU Switcher starts it at logon on the GPU you pick.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Add app"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Left" Content="Take over all" Click="StartupTakeAll_Click"
                                ToolTip="Every startup app that's on right now, except Windows and driver stuff"/>
                        <Button DockPanel.Dock="Left" x:Name="StartupGiveAll" Content="Give all back to Windows" Margin="8,0,0,0" Click="StartupGiveAll_Click"/>
                        <Button DockPanel.Dock="Left" x:Name="StartupTest" Content="Test launch" Margin="8,0,0,0" Click="StartupTest_Click"
                                ToolTip="Launches every app GPU Switcher manages right now, the same way it does at logon"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox x:Name="StartupTakeNew" Style="{StaticResource Switch}" Content="Also take over new startup apps" VerticalAlignment="Center" Click="StartupTakeNew_Click"/>
                            <TextBlock Text="Gap" Foreground="{DynamicResource Sub}" FontSize="13" VerticalAlignment="Center" Margin="16,0,8,0"/>
                            <TextBox x:Name="StartupGap" Width="50" Padding="4,6" TextAlignment="Center" LostFocus="StartupGap_LostFocus" ToolTip="Seconds between launching each app"/>
                            <TextBlock Text="s" Foreground="{DynamicResource Sub}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Layer}">
                        <DockPanel Grid.IsSharedSizeScope="True">
                            <Grid DockPanel.Dock="Top" Margin="10,0,18,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto" MinWidth="206" SharedSizeGroup="Pick"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="App" Style="{StaticResource Caption}"/>
                                <TextBlock Grid.Column="2" Text="Started by" Style="{StaticResource Caption}"/>
                                <TextBlock Grid.Column="3" Text="Use GPU" Style="{StaticResource Caption}"/>
                            </Grid>
                            <ListBox x:Name="StartupList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto" MinWidth="206" SharedSizeGroup="Pick"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Sub}" Style="{StaticResource SubText}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.Command}"/>
                                            </StackPanel>
                                            <ContentPresenter Grid.Column="2" Content="{Binding Mode}" ContentTemplate="{StaticResource ChoicePicker}" VerticalAlignment="Center"/>
                                            <ContentPresenter Grid.Column="3" Content="{Binding Gpu}" ContentTemplate="{StaticResource ChoicePicker}" VerticalAlignment="Center" Visibility="{Binding GpuVisible}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ================= OVERLAYS ================= -->
            <TabItem Header="Overlays">
                <ScrollViewer x:Name="OverlaysScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource SubText}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Click-through windows on top of your games, nothing gets injected into the game. They show over borderless and windowed games; exclusive fullscreen skips the desktop, so pick 'Windowed fullscreen' / 'Borderless' in the game's settings. The hotkeys work from inside games."/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" ToolTip="Turns the overlay on and off, also from inside a game">
                                        <TextBlock x:Name="PerfKeysText" FontSize="11" Foreground="{DynamicResource Sub}"/>
                                    </Border>
                                    <TextBlock Text="Performance overlay" Style="{StaticResource H2}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubText}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,14"
                                           Text="FPS, GPU and CPU numbers and your PC's specs on the screen the game is on (or one display you pick). FPS works for DirectX games (most of them); OpenGL and Vulkan games show '-'. Temperatures, clocks, power and fan need an NVIDIA card."/>
                                <CheckBox x:Name="PerfOn" Style="{StaticResource Switch}" Content="Show the overlay" Click="PerfOn_Click" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Position" VerticalAlignment="Center" FontSize="13"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ContentPresenter x:Name="PerfCornerPicker" ContentTemplate="{StaticResource ChoicePicker}"/>
                                        <Button x:Name="PerfMoveButton" Style="{StaticResource SmallButton}" Margin="10,0,0,0" VerticalAlignment="Center" Click="PerfMove_Click"
                                                ToolTip="Drag the overlay anywhere on the screen. Double-click or right-click it when it's in place."/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Display" VerticalAlignment="Center" FontSize="13"/>
                                    <ContentPresenter Grid.Column="1" x:Name="PerfMonitorPicker" ContentTemplate="{StaticResource ChoicePicker}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Size" VerticalAlignment="Center" FontSize="13"/>
                                    <ContentPresenter Grid.Column="1" x:Name="PerfSizePicker" ContentTemplate="{StaticResource ChoicePicker}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Background" VerticalAlignment="Center" FontSize="13"/>
                                    <ContentPresenter Grid.Column="1" x:Name="PerfBgPicker" ContentTemplate="{StaticResource ChoicePicker}"/>
                                </Grid>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="GPUs" VerticalAlignment="Center" FontSize="13"/>
                                    <ContentPresenter Grid.Column="1" x:Name="PerfGpuPicker" ContentTemplate="{StaticResource ChoicePicker}"/>
                                </Grid>
                                <TextBlock Text="Show" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="PerfItemsList" Margin="0,0,0,14">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource Switch}" Content="{Binding Label}" IsChecked="{Binding On}" Tag="{Binding Key}" Click="PerfItem_Click" Margin="0,0,0,10"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Spec sheet" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="PerfSpecList">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource Switch}" Content="{Binding Label}" IsChecked="{Binding On}" Tag="{Binding Key}" Click="PerfItem_Click" Margin="0,0,0,10"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,0" ToolTip="Place covers: press it while the game is in front">
                                            <TextBlock x:Name="EditKeysText" FontSize="11" Foreground="{DynamicResource Sub}"/>
                                        </Border>
                                        <Border Style="{StaticResource Chip}" ToolTip="Reveal the money (and cover it again)">
                                            <TextBlock x:Name="RevealKeysText" FontSize="11" Foreground="{DynamicResource Sub}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Money covers" Style="{StaticResource H2}"/>
                                </DockPanel>
                                <TextBlock x:Name="CoversHelp" Style="{StaticResource SubText}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <CheckBox x:Name="CoversOn" Style="{StaticResource Switch}" Content="Covers on (off = money revealed)" Click="CoversOn_Click" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Color" VerticalAlignment="Center" FontSize="13"/>
                                    <ContentPresenter Grid.Column="1" x:Name="CoverColorPicker" ContentTemplate="{StaticResource ChoicePicker}"/>
                                </Grid>
                                <CheckBox x:Name="CoverLabel" Style="{StaticResource Switch}" Content="Show ??? on the covers" Click="CoverLabel_Click" Margin="0,4,0,16"/>
                                <TextBlock Text="Games with covers" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="CoverGamesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource SmallButton}" Tag="{Binding Exe}" Click="RemoveCovers_Click"/>
                                                <TextBlock Text="{Binding Exe}" FontSize="13" VerticalAlignment="Center" Width="260" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoCoverGames" Style="{StaticResource SubText}" Text="None yet." FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= SETTINGS ================= -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,10,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Auto-assign" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource SubText}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,14"
                                           Text="Gives every app that doesn't have a GPU choice yet a default, the moment it shows up. Games (Steam / Epic / Riot... folders, Unity and Unreal games) get their own GPU. Apps you already set, or change by hand later, are never touched."/>
                                <CheckBox x:Name="AutoEnabled" Style="{StaticResource Switch}" Content="Turn on auto-assign" Click="AutoEnabled_Click" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Apps go to" VerticalAlignment="Center" FontSize="13"/>
                                    <ContentPresenter Grid.Column="1" x:Name="AutoAppsPicker" ContentTemplate="{StaticResource ChoicePicker}"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Games go to" VerticalAlignment="Center" FontSize="13"/>
                                    <ContentPresenter Grid.Column="1" x:Name="AutoGamesPicker" ContentTemplate="{StaticResource ChoicePicker}"/>
                                </Grid>
                                <CheckBox x:Name="AutoLive" Style="{StaticResource Switch}" Content="Also move running Chromium / Electron apps right away (Discord, browsers...)" Click="AutoLive_Click" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Assign all installed apps now" Style="{StaticResource AccentButton}" Click="AssignInstalled_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="UndoAuto" Content="Undo auto-assign" Click="UndoAuto_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Startup" Style="{StaticResource H2}"/>
                                <CheckBox x:Name="Autostart" Style="{StaticResource Switch}" Content="Start with Windows (in the tray, as admin, no UAC prompt)" Click="Autostart_Click" Margin="0,4,0,12"/>
                                <CheckBox x:Name="ReturnApps" Style="{StaticResource Switch}" Content="When a GPU comes back on (force mode, scripts...), move apps that belong on it back" Click="ReturnApps_Click"
                                          ToolTip="Chromium apps switch live. Other apps get restarted (tray apps force-closed). Games, launchers and terminals are left alone."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Safety" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource SubText}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,14"
                                           Text="A GPU is only ever turned off for a few seconds and never the one your monitors are on. It always comes back: right after the action, from a separate watchdog if this app crashes, at the next start of this app, and at the latest after a reboot (the switch-off isn't saved by Windows)."/>
                                <Button HorizontalAlignment="Left" Click="EnableAll_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Re-enable all GPUs now"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Live switching compatibility" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource SubText}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Text="Windows can't move a running app to another GPU by itself, the app has to rebuild its graphics. Chromium / Electron apps can do that in both directions (only that app blinks). Some other apps survive their GPU being turned off and move away from it. Games don't. Results from 'Move everything off' get added here automatically."/>
                                <ItemsControl x:Name="CompatList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Exe}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding Brush}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Kind}" FontSize="13"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource SubText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Button HorizontalAlignment="Left" Click="OpenLogs_Click" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Open log folder"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" x:Name="StatusText" Style="{StaticResource SubText}" Margin="2,10,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
